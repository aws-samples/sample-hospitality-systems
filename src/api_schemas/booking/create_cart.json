{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "CreateBookingCart",
  "type": "object",
  "additionalProperties": false,
  "required": ["propertyId", "roomTypeId", "ratePlanId", "checkIn", "checkOut", "sessionId"],
  "properties": {
    "propertyId": { "type": "string", "minLength": 1 },
    "roomTypeId": { "type": "string", "minLength": 1 },
    "ratePlanId": { "type": "string", "minLength": 1 },
    "checkIn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "checkOut": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "adults": { "type": "integer", "minimum": 1, "maximum": 8 },
    "children": { "type": "integer", "minimum": 0, "maximum": 8 }
  }
}
