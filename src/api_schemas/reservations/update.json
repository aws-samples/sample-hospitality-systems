{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "UpdateReservation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checkInDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "checkOutDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "adults": { "type": "integer", "minimum": 1, "maximum": 8 },
    "children": { "type": "integer", "minimum": 0, "maximum": 8 },
    "additionalNotes": { "type": "string", "maxLength": 2000 }
  }
}
